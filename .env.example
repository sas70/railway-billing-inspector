# Account token from https://railway.com/account/tokens
# Create token → No workspace (covers every workspace you belong to).
RAILWAY_TOKEN_MAIN=

# Recommended on first run: keep Turn on / Turn off disabled until you look around.
# DASHBOARD_READ_ONLY=true

# Project names or IDs this app must never change.
# PROTECTED_PROJECTS=my-prod-api,billing-db

# Limit RAILWAY_TOKEN_MAIN to one workspace.
# RAILWAY_TOKEN_MAIN_WORKSPACE_ID=

# Extra accounts (each RAILWAY_TOKEN_<NAME> is one account).
# RAILWAY_TOKEN_WORK=

# HTTP Basic password (any username). Set this if a real token is on Vercel.
# DASHBOARD_PASSWORD=

# Extra allowed Host headers beyond 127.0.0.1 / localhost.
# Hostname only, or a full URL — https:// is stripped. Comma-separated.
# On Vercel with a real token, also set DASHBOARD_PASSWORD; then *.vercel.app is allowed.
# DASHBOARD_ALLOWED_HOSTS=my-app.vercel.app

# Public OSS Vercel demo uses fake data when no token is set. Do not set a
# real token on the public railway-billing-inspector project.
# RAILWAY_MOCK=true

# Where to write the audit log (default: ./data).
# AUDIT_LOG_DIR=

# ── Search: READMEs and code (read-only) ────────────────────────────────────
# Folders that contain your local clones (searched two levels deep). Each clone's
# GitHub remote is matched to the repo a Railway service deploys from.
# CODE_LOCAL_ROOTS=~/Coding,~/work

# Read-only GitHub token for repos you haven't cloned (fine-grained: Contents + Metadata: read).
# Locally, the GitHub CLI's login (`gh auth token`) is used when this is empty.
# GITHUB_TOKEN=
# Set to false to stop falling back to the GitHub CLI token.
# CODE_USE_GH_CLI=true

# AI summaries of each repo's code (Claude). Adds a "Summarize with Claude" button on
# Search. Summaries are saved in <clone>/.railway-inspector/summary.json (git-ignored via
# .git/info/exclude) or data/code-summaries/ for GitHub-only repos, stamped with the commit,
# and regenerated only when the code changes. Local only — ignored on Vercel.
# ANTHROPIC_API_KEY=
