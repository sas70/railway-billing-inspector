# Account token from https://railway.com/account/tokens
# Create token → No workspace (covers every workspace you belong to).
RAILWAY_TOKEN_MAIN=

# Recommended on first run: keep Turn on / Turn off disabled until you look around.
# DASHBOARD_READ_ONLY=true

# Project names or IDs this app must never change.
# PROTECTED_PROJECTS=my-prod-api,billing-db

# Limit RAILWAY_TOKEN_MAIN to one workspace.
# RAILWAY_TOKEN_MAIN_WORKSPACE_ID=

# Extra accounts (each RAILWAY_TOKEN_<NAME> is one account).
# RAILWAY_TOKEN_WORK=

# Optional password gate for the dashboard.
# DASHBOARD_PASSWORD=

# Extra allowed Host headers if you expose this beyond 127.0.0.1.
# DASHBOARD_ALLOWED_HOSTS=

# Where to write the audit log (default: ./data).
# AUDIT_LOG_DIR=
